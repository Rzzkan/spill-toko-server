# Salin ke .env lalu isi. Kunci/ rahasia lain (Google, Midtrans, AI) diisi nanti lewat dashboard admin.
APP_NAME="TemanSeller"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://temanseller.com
APP_KEY=                       # php artisan key:generate --show  (lihat langkah 3)
ADMIN_EMAIL=emailmu@gmail.com  # akun admin pertama

DB_CONNECTION=mysql
DB_DATABASE=temanseller
DB_USERNAME=temanseller
DB_PASSWORD=GANTI_PASSWORD_DB_KUAT
DB_ROOT_PASSWORD=GANTI_PASSWORD_ROOT_KUAT

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
