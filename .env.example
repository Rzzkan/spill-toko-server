APP_NAME="TemanSeller"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://temanseller.com
APP_TIMEZONE=UTC

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Hanya koneksi database & kunci aplikasi yang ada di sini.
# Semua konfigurasi kenari.id, Midtrans, dan Google diatur dari dashboard admin.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=spilltoko
DB_USERNAME=spilltoko
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
SHOFEE_URL=
